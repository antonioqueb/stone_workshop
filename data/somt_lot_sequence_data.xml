<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Folio único y corto para lotes NUEVOS producidos por corte/formato
             en taller: SOMT-001, SOMT-002… (SOM Taller). El lote de un corte
             nace desde cero — jamás hereda el folio de las placas origen. -->
        <record id="seq_somt_lot" model="ir.sequence">
            <field name="name">Lote de taller (SOMT)</field>
            <field name="code">stone.workshop.somt.lot</field>
            <field name="prefix">SOMT-</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>
    </data>
</odoo>
