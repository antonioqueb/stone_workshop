<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="seq_workshop_order" model="ir.sequence">
            <field name="name">Orden de Taller</field>
            <field name="code">workshop.order</field>
            <field name="prefix">T-TALLER/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- La normalización WS/* → T-TALLER/* ya cumplió su propósito en
             todos los ambientes; ejecutarla en CADA actualización del módulo
             (search + loop sobre órdenes) solo alentaba los deploys. El
             método _normalize_workshop_references se conserva por si se
             necesita correr manualmente. -->
    </data>
</odoo>
