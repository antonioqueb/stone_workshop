<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_reclassification_label_wizard_form" model="ir.ui.view">
        <field name="name">stock.lot.reclassification.label.wizard.form</field>
        <field name="model">stock.lot.reclassification.label.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimir etiquetas">
                <group>
                    <field name="reclassification_id" invisible="1"/>
                    <field name="lot_count" string="Lotes nuevos"/>
                    <field name="label_format" widget="radio"/>
                </group>
                <footer>
                    <button name="action_print" type="object"
                            string="Descargar etiquetas (.zpl)"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
