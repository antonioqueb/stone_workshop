<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú principal (app de primer nivel), ya no anidado bajo Manufactura.

         La app es SOLO para gente de taller. group_workshop_sales quedó
         fuera a propósito: ese grupo existe para que la orden de venta
         pueda leer procesos y OTs (pestaña Taller, selector de entradas,
         cadena de procesos) — no para darle al vendedor una app de
         producción que no le toca. Quitarle el grupo al vendedor NO es la
         salida: le tumba la pestaña Taller de su propia venta.

         EL "-" NO SOBRA: groups= en un menuitem SUMA grupos (Odoo lo
         compila a (4, id)), no los reemplaza. Quitar group_workshop_sales
         de la lista dejaba el grupo puesto en el menú y el vendedor lo
         seguía viendo. El prefijo "-" es el (3, id) que sí lo despega. -->
    <menuitem id="menu_workshop_root"
              name="Taller de Piedra"
              web_icon="stone_workshop,static/description/icon.svg"
              sequence="50"
              groups="-stone_workshop.group_workshop_sales,stone_workshop.group_workshop_user"/>

    <menuitem id="menu_workshop_dashboard"
              name="Panel de Taller"
              parent="menu_workshop_root"
              action="action_workshop_dashboard"
              sequence="1"
              groups="-stone_workshop.group_workshop_sales,stone_workshop.group_workshop_user"/>

    <menuitem id="menu_workshop_orders"
              name="Órdenes de Taller"
              parent="menu_workshop_root"
              action="action_workshop_order"
              sequence="10"
              groups="stone_workshop.group_workshop_user"/>

    <menuitem id="menu_workshop_trace"
              name="Trazabilidad"
              parent="menu_workshop_root"
              action="action_workshop_trace"
              sequence="20"
              groups="stone_workshop.group_workshop_user"/>

    <menuitem id="menu_workshop_config"
              name="Configuración"
              parent="menu_workshop_root"
              sequence="90"
              groups="stone_workshop.group_workshop_supervisor"/>

    <menuitem id="menu_workshop_settings"
              name="Ajustes de Taller"
              parent="menu_workshop_config"
              action="action_workshop_config_settings"
              sequence="5"
              groups="stone_workshop.group_workshop_supervisor"/>

    <menuitem id="menu_workshop_process"
              name="Procesos"
              parent="menu_workshop_config"
              action="action_workshop_process"
              sequence="10"
              groups="stone_workshop.group_workshop_supervisor"/>

    <menuitem id="menu_workshop_input_lines"
              name="Entradas"
              parent="menu_workshop_config"
              action="action_workshop_input_line"
              sequence="20"
              groups="stone_workshop.group_workshop_supervisor"/>

    <menuitem id="menu_workshop_output_lines"
              name="Salidas"
              parent="menu_workshop_config"
              action="action_workshop_output_line"
              sequence="30"
              groups="stone_workshop.group_workshop_supervisor"/>
</odoo>
