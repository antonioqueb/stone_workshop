<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_lot_writeoff_form" model="ir.ui.view">
        <field name="name">stock.lot.writeoff.form</field>
        <field name="model">stock.lot.writeoff</field>
        <field name="arch" type="xml">
            <form string="Baja de Material">
                <header>
                    <button name="action_confirm"
                            type="object"
                            string="Aplicar baja"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="El material seleccionado saldrá del inventario hacia la ubicación de desecho y los lotes quedarán archivados. Esta operación queda registrada y no se puede eliminar. ¿Continuar?"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancelar"
                            invisible="state != 'draft'"/>
                    <button name="action_draft"
                            type="object"
                            string="Volver a borrador"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_scraps"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-trash"
                                invisible="scrap_count == 0">
                            <field name="scrap_count" widget="statinfo" string="Desechos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Baja">
                            <field name="product_from_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="reason_type" readonly="state != 'draft'"/>
                        </group>
                        <group string="Control">
                            <field name="user_id" readonly="1"/>
                            <field name="date_done" invisible="not date_done"/>
                            <field name="company_id" invisible="1"/>
                            <field name="total_qty"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"
                               readonly="state != 'draft'"
                               placeholder="Describe qué pasó con el material (se rompió en maniobra, llegó fracturado, etc.)..."/>
                    </group>
                    <!-- El widget se monta DIRECTO sobre line_ids; la lista
                         embebida declara los subcampos que viajan en el spec
                         de web_read/web_save (Odoo 19). -->
                    <field name="line_ids"
                           widget="writeoff_lot_selector"
                           nolabel="1"
                           colspan="2"
                           readonly="state != 'draft'">
                        <list>
                            <field name="lot_from_id"/>
                            <field name="qty_available"/>
                            <field name="qty_moved"/>
                            <field name="location_note"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_stock_lot_writeoff_list" model="ir.ui.view">
        <field name="name">stock.lot.writeoff.list</field>
        <field name="model">stock.lot.writeoff</field>
        <field name="arch" type="xml">
            <list string="Bajas de Material" default_order="create_date desc">
                <field name="name"/>
                <field name="product_from_id"/>
                <field name="reason_type"/>
                <field name="line_count"/>
                <field name="total_qty" sum="Total"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="date_done"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_stock_lot_writeoff_search" model="ir.ui.view">
        <field name="name">stock.lot.writeoff.search</field>
        <field name="model">stock.lot.writeoff</field>
        <field name="arch" type="xml">
            <search string="Bajas de Material">
                <field name="name"/>
                <field name="product_from_id"/>
                <field name="line_ids" string="Lote"
                       filter_domain="[('line_ids.lot_from_id.name', 'ilike', self)]"/>
                <field name="user_id"/>
                <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Aplicadas" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Canceladas" name="cancel" domain="[('state', '=', 'cancel')]"/>
                <filter string="Producto" name="group_product" context="{'group_by': 'product_from_id'}"/>
                <filter string="Tipo de baja" name="group_reason" context="{'group_by': 'reason_type'}"/>
                <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_stock_lot_writeoff" model="ir.actions.act_window">
        <field name="name">Baja de Material</field>
        <field name="res_model">stock.lot.writeoff</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea una baja de material</p>
            <p>
                Da de baja lotes completos que ya no existen físicamente
                (rotura, merma, extravío): el material sale del inventario
                hacia la ubicación de desecho con trazabilidad completa, el
                lote se archiva y queda visible en el Walkthrough como
                historial.
            </p>
        </field>
    </record>

    <menuitem id="menu_stock_lot_writeoff"
              name="Baja de Material"
              parent="stock.menu_stock_adjustments"
              action="action_stock_lot_writeoff"
              sequence="21"
              groups="stock.group_stock_user"/>

</odoo>
