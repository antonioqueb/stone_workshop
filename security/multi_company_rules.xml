<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Reglas de registro multiempresa: cada documento de taller se ve
             solo en las compañías seleccionadas; company_id vacío = compartido
             (catálogos: procesos y recetas). -->

        <record id="rule_workshop_order_company" model="ir.rule">
            <field name="name">Orden de taller: multiempresa</field>
            <field name="model_id" ref="model_workshop_order"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

