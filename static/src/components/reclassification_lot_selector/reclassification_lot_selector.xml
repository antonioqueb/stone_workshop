<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="stone_workshop.ReclassificationLotSelector" owl="1">
        <div class="wls-panel" t-att-class="canEdit() ? '' : 'is-readonly'">
            <div class="wls-header">
                <div class="wls-title-block">
                    <span class="wls-icon"><i class="fa fa-exchange"/></span>
                    <div>
                        <h3>Lotes a reclasificar</h3>
                        <p t-if="getProductId()">
                            Producto origen: <strong><t t-esc="getProductName()"/></strong>
                        </p>
                        <p t-else="">Selecciona primero el producto origen.</p>
                    </div>
                </div>
                <div class="wls-actions">
                    <span class="wls-pill wls-pill-count">
                        <i class="fa fa-check-circle"/> <t t-esc="selectedRows.length"/> lotes
                    </span>
                    <span class="wls-pill wls-pill-area">
                        <i class="fa fa-balance-scale"/> <t t-esc="formatNum(totalQty)"/> m²
                    </span>
                    <button type="button"
                            class="wls-btn wls-btn-primary"
                            t-if="canEdit()"
                            t-on-click="openPopup"
                            t-att-disabled="!getProductId()">
                        <i class="fa fa-plus"/> Seleccionar lotes
                    </button>
                </div>
            </div>

            <div t-if="!getProductId()" class="wls-empty wls-empty-warning">
                <i class="fa fa-info-circle"/>
                <span>Define el producto origen para cargar el inventario disponible.</span>
            </div>

            <div t-elif="selectedRows.length === 0" class="wls-empty">
                <i class="fa fa-cubes"/>
                <span>No hay lotes seleccionados. Usa "Seleccionar lotes" para elegirlos visualmente.</span>
            </div>

            <div t-else="" class="wls-table-wrap">
                <table class="wls-table">
                    <thead>
                        <tr>
                            <th>Lote</th>
                            <th>Bloque</th>
                            <th>Atado</th>
                            <th class="text-end">Alto</th>
                            <th class="text-end">Largo</th>
                            <th class="text-end">Esp.</th>
                            <th>Tipo</th>
                            <th class="text-end">Existencia</th>
                            <th t-if="isDone()">Lote destino</th>
                            <th t-if="isDone()" class="text-end">Movido</th>
                            <th t-if="isDone()">Ubicaciones</th>
                            <th t-if="canEdit()" class="wls-col-action"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="selectedRows" t-as="row" t-key="row.key">
                            <td class="wls-cell-lot"><t t-esc="row.lot_name"/></td>
                            <td><t t-esc="row.bloque || '-'"/></td>
                            <td><t t-esc="row.atado || '-'"/></td>
                            <td class="text-end"><t t-esc="formatDim(row.alto)"/></td>
                            <td class="text-end"><t t-esc="formatDim(row.ancho)"/></td>
                            <td class="text-end"><t t-esc="formatDim(row.grosor)"/></td>
                            <td><t t-esc="row.tipo || '-'"/></td>
                            <td class="text-end fw-bold"><t t-esc="formatNum(row.qty)"/></td>
                            <td t-if="isDone()"><t t-esc="row.lot_to_name || '-'"/></td>
                            <td t-if="isDone()" class="text-end"><t t-esc="formatNum(row.qty_moved)"/></td>
                            <td t-if="isDone()" class="text-muted"><t t-esc="row.location_note || '-'"/></td>
                            <td t-if="canEdit()" class="wls-col-action">
                                <button type="button" class="wls-remove" t-on-click="(ev) => this.removeLot(row.lot_id, ev)" title="Quitar lote">
                                    <i class="fa fa-times"/>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>
</templates>
